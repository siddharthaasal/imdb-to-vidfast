{
  "manifest_version": 3,
  "name": "VidFast launcher",
  "version": "0.1.0",
  "description": "Open the IMDb title you're looking at in VidFast with one click.",
  "permissions": ["storage", "scripting", "activeTab", "contextMenus"],
  "host_permissions": ["https://*.imdb.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open in VidFast"
  }
}
